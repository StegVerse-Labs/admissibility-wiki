{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/governance-chain-certification-result.schema.json",
  "title": "Governance-Chain Certification Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "candidate_id",
    "subject_binding",
    "surface",
    "property_results",
    "overall_state",
    "evidence",
    "issued_at",
    "freshness"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "result_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "subject_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "version", "immutable_locator"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "immutable_locator": {"type": "string", "minLength": 1},
        "artifact_hash": {"type": ["string", "null"]}
      }
    },
    "surface": {"enum": ["PRE", "GOV", "POST", "INT"]},
    "property_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["property_id", "state", "evidence_refs"],
        "properties": {
          "property_id": {"type": "string", "minLength": 1},
          "state": {
            "enum": [
              "CERTIFIED",
              "CERTIFIED_WITH_LIMITS",
              "NOT_CERTIFIED",
              "INDETERMINATE",
              "STALE_OR_EXPIRED",
              "REVOKED"
            ]
          },
          "limits": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "overall_state": {
      "enum": [
        "CERTIFIED",
        "CERTIFIED_WITH_LIMITS",
        "NOT_CERTIFIED",
        "INDETERMINATE",
        "STALE_OR_EXPIRED",
        "REVOKED"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_ref", "validator_status"],
      "properties": {
        "packet_ref": {"type": "string", "minLength": 1},
        "packet_hash": {"type": ["string", "null"]},
        "validator_status": {"enum": ["PASS", "FAIL", "PARTIAL", "UNOBSERVED"]},
        "replay_status": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE", "UNOBSERVED"]},
        "reconstruction_status": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE", "UNOBSERVED"]}
      }
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule"],
      "properties": {
        "rule": {"type": "string", "minLength": 1},
        "valid_until": {"type": ["string", "null"], "format": "date-time"},
        "renewal_triggers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "commercial_relationship": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paid_access": {"type": "boolean"},
        "outcome_purchased": {"const": false}
      }
    },
    "authority_effect": {"const": "NONE"}
  }
}
