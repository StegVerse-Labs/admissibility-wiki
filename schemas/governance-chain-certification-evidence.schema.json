{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/governance-chain-certification-evidence.schema.json",
  "title": "Governance Chain Certification Evidence Packet",
  "type": "object",
  "required": ["schema_version", "candidate_id", "profile_id", "implementation_version", "observed_at", "fresh_until", "evidence", "negative_controls", "lifecycle"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "candidate_id": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "implementation_version": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "fresh_until": {"type": "string", "format": "date-time"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "kind", "sha256", "source", "supports"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["receipt", "trace", "fixture_result", "artifact", "source_snapshot", "replay", "reconstruction", "custody_record"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "source": {"type": "string", "minLength": 1},
          "supports": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["control_id", "expected", "observed", "passed"],
        "properties": {
          "control_id": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "observed": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["state", "renewal_requires_retest", "revocation_reasons"],
      "properties": {
        "state": {"enum": ["CANDIDATE", "CURRENT", "EXPIRED", "SUSPENDED", "REVOKED", "SUPERSEDED"]},
        "renewal_requires_retest": {"const": true},
        "revocation_reasons": {
          "type": "array",
          "items": {"enum": ["implementation_changed", "profile_changed", "evidence_invalidated", "material_environment_change", "misrepresentation", "verification_failure", "authority_withdrawn"]}
        },
        "supersedes_certificate_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
