{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/gsdp/governed-system-description.schema.json",
  "title": "Governed System Description Protocol Declaration",
  "description": "Draft structural schema for a machine-readable governed-system declaration. Schema validity is not independent conformance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "gsdp_version",
    "declaration_id",
    "system",
    "operators",
    "components",
    "authority",
    "governance",
    "evidence",
    "status",
    "dependencies",
    "history",
    "claims",
    "explicit_non_claims"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "gsdp_version": { "type": "string", "const": "0.1-draft" },
    "declaration_id": { "type": "string", "format": "uri" },
    "system": { "$ref": "#/$defs/system" },
    "operators": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operator" }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "authority": { "$ref": "#/$defs/authorityEnvelope" },
    "governance": { "$ref": "#/$defs/governance" },
    "evidence": { "$ref": "#/$defs/evidence" },
    "status": { "$ref": "#/$defs/status" },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "history": { "$ref": "#/$defs/history" },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "explicit_non_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "conformance": { "$ref": "#/$defs/conformance" }
  },
  "$defs": {
    "uriId": { "type": "string", "format": "uri-reference", "minLength": 1 },
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "class", "canonical_uri", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/uriId" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "class": { "type": "string", "minLength": 1 },
        "canonical_uri": { "type": "string", "format": "uri" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "relationship", "component_refs", "authority", "explicit_non_authority", "effective_from"],
      "properties": {
        "id": { "$ref": "#/$defs/uriId" },
        "name": { "type": "string", "minLength": 1 },
        "relationship": { "type": "string", "minLength": 1 },
        "component_refs": { "$ref": "#/$defs/stringArray" },
        "authority": { "$ref": "#/$defs/stringArray" },
        "explicit_non_authority": { "$ref": "#/$defs/stringArray" },
        "effective_from": { "type": "string", "format": "date-time" },
        "effective_until": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "class", "role", "status", "operator_refs", "capabilities", "authority", "explicit_non_authority", "inputs", "outputs", "dependencies", "interfaces", "evidence_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/uriId" },
        "name": { "type": "string", "minLength": 1 },
        "class": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "operator_refs": { "$ref": "#/$defs/stringArray" },
        "capabilities": { "$ref": "#/$defs/stringArray" },
        "authority": { "$ref": "#/$defs/stringArray" },
        "explicit_non_authority": { "$ref": "#/$defs/stringArray" },
        "inputs": { "$ref": "#/$defs/stringArray" },
        "outputs": { "$ref": "#/$defs/stringArray" },
        "dependencies": { "$ref": "#/$defs/stringArray" },
        "interfaces": { "$ref": "#/$defs/stringArray" },
        "evidence_refs": { "$ref": "#/$defs/stringArray" }
      }
    },
    "authorityEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classes", "delegations", "revocation_sources", "standing_requirements", "consent_requirements", "commit_authorities", "explicit_non_authorities"],
      "properties": {
        "classes": { "$ref": "#/$defs/stringArray" },
        "delegations": { "type": "array", "items": { "type": "object" } },
        "revocation_sources": { "$ref": "#/$defs/stringArray" },
        "standing_requirements": { "$ref": "#/$defs/stringArray" },
        "consent_requirements": { "$ref": "#/$defs/stringArray" },
        "commit_authorities": { "$ref": "#/$defs/stringArray" },
        "explicit_non_authorities": { "$ref": "#/$defs/stringArray" }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_states", "policy_sources", "admissibility_rules", "safe_states", "rollback_conditions", "dispute_routes"],
      "properties": {
        "decision_states": { "$ref": "#/$defs/stringArray" },
        "policy_sources": { "$ref": "#/$defs/stringArray" },
        "admissibility_rules": { "$ref": "#/$defs/stringArray" },
        "safe_states": { "$ref": "#/$defs/stringArray" },
        "rollback_conditions": { "$ref": "#/$defs/stringArray" },
        "dispute_routes": { "$ref": "#/$defs/stringArray" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_schemas", "verification_methods", "custody_refs", "replay_interfaces", "reconstruction_procedures", "retention_rules"],
      "properties": {
        "receipt_schemas": { "$ref": "#/$defs/stringArray" },
        "verification_methods": { "$ref": "#/$defs/stringArray" },
        "custody_refs": { "$ref": "#/$defs/stringArray" },
        "replay_interfaces": { "$ref": "#/$defs/stringArray" },
        "reconstruction_procedures": { "$ref": "#/$defs/stringArray" },
        "retention_rules": { "$ref": "#/$defs/stringArray" }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "implemented", "tested", "independently_verified", "certified", "operational", "authorized"],
      "properties": {
        "declared": { "type": "string" },
        "implemented": { "type": "string" },
        "tested": { "type": "string" },
        "independently_verified": { "type": "string" },
        "certified": { "type": "string" },
        "operational": { "type": "string" },
        "authorized": { "type": "string" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "authority_bearing", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/uriId" },
        "type": { "enum": ["technical", "evidentiary", "operational", "governance", "authority"] },
        "authority_bearing": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective_from", "effective_until", "supersedes", "previous_declaration", "declaration_hash", "evidence_cutoff"],
      "properties": {
        "effective_from": { "type": "string", "format": "date-time" },
        "effective_until": { "type": ["string", "null"], "format": "date-time" },
        "supersedes": { "type": ["string", "null"] },
        "previous_declaration": { "type": ["string", "null"] },
        "declaration_hash": { "type": ["string", "null"] },
        "evidence_cutoff": { "type": "string", "format": "date-time" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "status", "evidence_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/uriId" },
        "statement": { "type": "string", "minLength": 1 },
        "status": { "enum": ["declared", "supported", "internally_verified", "independently_verified", "disputed", "superseded", "withdrawn"] },
        "evidence_refs": { "$ref": "#/$defs/stringArray" }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimed_classes", "schema_validated", "independent_assessment"],
      "properties": {
        "claimed_classes": {
          "type": "array",
          "items": { "enum": ["GSDP-DISCOVERABLE", "GSDP-GOVERNED", "GSDP-EVIDENCED", "GSDP-RECONSTRUCTABLE", "GSDP-INTEROPERABLE", "GSDP-CERTIFIABLE"] },
          "uniqueItems": true
        },
        "schema_validated": { "type": "boolean" },
        "independent_assessment": { "type": "string" }
      }
    }
  }
}
