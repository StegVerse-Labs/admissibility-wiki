{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse-labs.github.io/admissibility-wiki/schemas/framework-reconstruction-submission.schema.json",
  "title": "Framework Reconstruction Submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "submission_id", "review_id", "reviewer", "performed_at", "result", "artifact_refs", "method", "authority_boundary"],
  "properties": {
    "schema_version": {"const": "framework-reconstruction-submission.v1"},
    "submission_id": {"type": "string", "minLength": 1},
    "review_id": {"type": "string", "minLength": 1},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "declared_conflicts"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["PERSON", "ORGANIZATION", "FRAMEWORK", "AI_ENTITY", "GOVERNMENT", "OTHER"]},
        "declared_conflicts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "performed_at": {"type": "string", "format": "date-time"},
    "relevant_time_t": {"type": ["string", "null"], "format": "date-time"},
    "result": {"enum": ["REPRODUCED", "PARTIAL", "DIVERGENT", "BLOCKED"]},
    "method": {"type": "string", "minLength": 1},
    "input_refs": {"type": "array", "items": {"type": "string"}},
    "artifact_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "difference_summary": {"type": ["string", "null"]},
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "claimed_determination_effect": {"enum": ["NONE", "CONFIRM", "CHALLENGE", "REQUEST_CORRECTION", "REQUEST_SUPERSESSION"]},
    "signature_or_receipt_ref": {"type": ["string", "null"]},
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certification_granted", "execution_authority_granted", "automatic_standing_change"],
      "properties": {
        "certification_granted": {"const": false},
        "execution_authority_granted": {"const": false},
        "automatic_standing_change": {"const": false}
      }
    }
  }
}
