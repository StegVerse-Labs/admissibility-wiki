{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse-labs.github.io/admissibility-wiki/schemas/framework-review-correction-receipt.schema.json",
  "title": "Framework Review Correction Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "review_id", "issued_at", "issuer", "reason", "changes", "prior_record_ref", "corrected_record_ref", "standing_effect", "authority_boundary"],
  "properties": {
    "schema_version": {"const": "framework-review-correction-receipt.v1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "review_id": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "issuer": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "trigger_refs": {"type": "array", "items": {"type": "string"}},
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "before", "after", "basis_refs"],
        "properties": {
          "field": {"type": "string"},
          "before": {},
          "after": {},
          "basis_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "prior_record_ref": {"type": "string", "minLength": 1},
    "corrected_record_ref": {"type": "string", "minLength": 1},
    "supersedes_receipt": {"type": ["string", "null"]},
    "standing_effect": {"enum": ["NONE", "INCREASE", "DECREASE", "SUPERSEDE", "WITHDRAW", "REVOKE"]},
    "dissent_preserved": {"type": "boolean"},
    "signature_or_receipt_ref": {"type": ["string", "null"]},
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correction_is_public_record", "certification_granted", "execution_authority_granted"],
      "properties": {
        "correction_is_public_record": {"const": true},
        "certification_granted": {"const": false},
        "execution_authority_granted": {"const": false}
      }
    }
  }
}
